{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",

    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,

    "allowJs": true,
    "checkJs": false,

    "ignoreDeprecations": "6.0",

    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"],
      "@next/*": ["resources/js/next/*"]
    },

    "types": ["vite/client"]
  },
  "include": ["resources/js/**/*", "vite.config.*"],
  "exclude": ["node_modules", "vendor"]
}
