APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Blank means "not Secure", which is right on a plain-HTTP localhost and wrong everywhere else. Set it
# to true once this application is served over HTTPS: it governs every cookie the app sets, including
# the OAuth handshake binding, whose value is a SECRET and whose theft — together with the authorize
# URL — is the one case the binding does not defend against (see config/publishing.php and
# App\Modules\Publishing\Services\OAuthStateService). Forcing it on here instead would mean the cookie
# is never stored in development and the connect flow refuses itself.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (websocket broadcasting). Generate local app credentials; these are NOT external secrets.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated origins allowed to open a websocket ('*' for local dev). Restrict to the app's own
# origin(s) in production — channel data is still gated by /broadcasting/auth, this is defence-in-depth.
REVERB_ALLOWED_ORIGINS=*

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Disk — PDF thumbnails (poppler `pdftoppm` must be on the server; absent → the grid shows a glyph).
DISK_THUMBNAILS_ENABLED=true
DISK_PDFTOPPM_PATH=pdftoppm
DISK_THUMBNAIL_SCALE=480
DISK_THUMBNAIL_TIMEOUT=20

# Disk — AI edit tuning (gpt-image-1 image edits + sync gpt-4o text edits). Defaults are sensible.
AI_DISK_IMAGE_QUALITY=high
AI_DISK_IMAGE_BACKGROUND=opaque
AI_TEXT_TIMEOUT=60

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Publishing — connected accounts (R4 B2)
# ─────────────────────────────────────────────────────────────────────────────────────────────────
# ALL BLANK BY DESIGN. The applications with Google and Meta do not exist yet; until they are
# registered, every real destination reports "not configured" at the door rather than sending anybody
# to a consent screen that would reject them.
#
# PUBLISHING_OAUTH_REDIRECT_BASE is the PUBLIC HTTPS ORIGIN the platforms redirect back to, e.g.
# https://app.example.com. Blank means "derive it from APP_URL", which is right everywhere except the
# case that matters first: both platforms require an HTTPS redirect URI registered on their side, and
# http://localhost is not one. The value here must produce a callback URL matching the registered one
# EXACTLY — a trailing slash is a rejected handshake.
#
# ITS HOST MUST BE THE HOST THE APPLICATION IS SERVED FROM (or one covered by SESSION_DOMAIN above).
# The OAuth handshake binding is a host-only cookie set when the SPA calls authorize and read when the
# platform redirects back; if the two hosts differ, the browser never sends it and EVERY legitimate
# connect fails with `oauth_browser_mismatch` — a symptom that looks like broken code and is a typo.
PUBLISHING_OAUTH_REDIRECT_BASE=
# Where the browser lands afterwards, with the outcome in the query string.
PUBLISHING_OAUTH_RETURN_PATH=/next/publishing/connections

# How long a handshake may stay open, in seconds, and how much longer its single-use ledger entry (and
# the browser-binding cookie) outlive the signed payload. The grace is what keeps "expired" and "already
# used" telling a user two different, true things instead of racing.
PUBLISHING_OAUTH_STATE_TTL=600
PUBLISHING_OAUTH_STATE_LEDGER_GRACE=120

# Token renewal. The LEAD is how far ahead of expiry a token is refreshed — a full day, sized against
# the Meta long-lived token, which cannot be recovered once it lapses. The BATCH caps one pass PER
# DATABASE, which in shared mode is the whole common estate rather than one workspace; see the comment
# in config/publishing.php before raising or lowering it.
PUBLISHING_TOKEN_REFRESH_LEAD=86400
PUBLISHING_TOKEN_REFRESH_BATCH=200

PUBLISHING_YOUTUBE_CLIENT_ID=
PUBLISHING_YOUTUBE_CLIENT_SECRET=
PUBLISHING_FACEBOOK_CLIENT_ID=
PUBLISHING_FACEBOOK_CLIENT_SECRET=
PUBLISHING_INSTAGRAM_CLIENT_ID=
PUBLISHING_INSTAGRAM_CLIENT_SECRET=
